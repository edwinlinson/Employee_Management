{
  "info": {
    "name": "Employee Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run 'Create employee' first; it stores the new id in the {{employeeId}} collection variable."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "employeeId", "value": "1" }
  ],
  "item": [
    {
      "name": "Create employee",
      "event": [{
        "listen": "test",
        "script": { "type": "text/javascript", "exec": [
          "pm.test('201 Created', () => pm.response.to.have.status(201));",
          "pm.collectionVariables.set('employeeId', pm.response.json().id);"
        ]}
      }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"phone\": \"+919876543210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"salary\": 85000.00,\n  \"dateOfJoining\": \"2024-06-15\",\n  \"status\": \"ACTIVE\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/employees", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees"] }
      }
    },
    {
      "name": "Create employee - validation error",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Menon\",\n  \"email\": \"not-an-email\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Engineer\",\n  \"salary\": -1,\n  \"dateOfJoining\": \"2999-01-01\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/employees", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees"] }
      }
    },
    {
      "name": "Get all employees (paged)",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/employees?page=0&size=10&sort=id,asc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees"],
          "query": [{ "key": "page", "value": "0" }, { "key": "size", "value": "10" }, { "key": "sort", "value": "id,asc" }] }
      }
    },
    {
      "name": "Search + filter by status",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/employees?search=engineering&status=ACTIVE&sort=salary,desc", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees"],
          "query": [{ "key": "search", "value": "engineering" }, { "key": "status", "value": "ACTIVE" }, { "key": "sort", "value": "salary,desc" }] }
      }
    },
    {
      "name": "Get employee by ID",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees", "{{employeeId}}"] }
      }
    },
    {
      "name": "Update employee",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"phone\": \"+919876543210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Senior Software Engineer\",\n  \"salary\": 110000.00,\n  \"dateOfJoining\": \"2024-06-15\",\n  \"status\": \"ON_LEAVE\"\n}" },
        "url": { "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees", "{{employeeId}}"] }
      }
    },
    {
      "name": "Delete employee",
      "request": {
        "method": "DELETE",
        "url": { "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}", "host": ["{{baseUrl}}"], "path": ["api", "v1", "employees", "{{employeeId}}"] }
      }
    }
  ]
}
