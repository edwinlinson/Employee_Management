              "raw": "[\n  {\n    \"firstName\": \"Valid\",\n    \"lastName\": \"User\",\n    \"email\": \"valid.user@example.com\",\n    \"department\": \"IT\",\n    \"designation\": \"Support\",\n    \"salary\": 40000,\n    \"dateOfJoining\": \"2024-03-01\"\n  },\n  {\n    \"firstName\": \"Bad\",\n    \"lastName\": \"Item\",\n    \"email\": \"not-an-email\",\n    \"department\": \"IT\",\n    \"designation\": \"Support\",\n    \"salary\": 0,\n    \"dateOfJoining\": \"2024-03-01\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Expect fieldErrors such as requests[1].email."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
