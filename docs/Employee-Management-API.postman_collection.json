            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"id\": \"{{bulkId1}}\",\n    \"employee\": {\n      \"firstName\": \"Meera\",\n      \"lastName\": \"Pillai\",\n      \"email\": \"meera.pillai@example.com\",\n      \"phone\": \"+919811111111\",\n      \"department\": \"Engineering\",\n      \"designation\": \"Senior Software Engineer\",\n      \"salary\": 105000,\n      \"dateOfJoining\": \"2024-01-10\",\n      \"status\": \"ACTIVE\"\n    }\n  },\n  {\n    \"id\": \"{{bulkId2}}\",\n    \"employee\": {\n      \"firstName\": \"Ravi\",\n      \"lastName\": \"Nair\",\n      \"email\": \"ravi.nair@example.com\",\n      \"department\": \"HR\",\n      \"designation\": \"HR Director\",\n      \"salary\": 95000,\n      \"dateOfJoining\": \"2023-02-01\",\n      \"status\": \"ON_LEAVE\"\n    }\n  }\n]",
              "options": {
