{
  "info": {
    "name": "Employee Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Single and bulk employee endpoints. Run requests top-to-bottom within each folder; create requests store ids in collection variables used by later requests."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "employeeId",
      "value": "1"
    },
    {
      "key": "bulkIds",
      "value": "1,2,3"
    },
    {
      "key": "bulkId1",
      "value": "1"
    },
    {
      "key": "bulkId2",
      "value": "2"
    },
    {
      "key": "bulkId3",
      "value": "3"
    }
  ],
  "item": [
    {
      "name": "Single employee",
      "item": [
        {
          "name": "Create employee",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"phone\": \"+919876543210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"salary\": 85000.0,\n  \"dateOfJoining\": \"2024-06-15\",\n  \"status\": \"ACTIVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set('employeeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"Menon\",\n  \"email\": \"not-an-email\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Engineer\",\n  \"salary\": -1,\n  \"dateOfJoining\": \"2999-01-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Create employee - duplicate email (409)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Software Engineer\",\n  \"salary\": 85000.0,\n  \"dateOfJoining\": \"2024-06-15\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('409 Conflict (run after Create employee)', () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Get all employees (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees?page=0&size=10&sort=id,asc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "id,asc"
                }
              ]
            }
          }
        },
        {
          "name": "Search + filter by status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees?search=engineering&status=ACTIVE&sort=salary,desc",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees"
              ],
              "query": [
                {
                  "key": "search",
                  "value": "engineering"
                },
                {
                  "key": "status",
                  "value": "ACTIVE"
                },
                {
                  "key": "sort",
                  "value": "salary,desc"
                }
              ]
            }
          }
        },
        {
          "name": "Get employee by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "{{employeeId}}"
              ]
            }
          }
        },
        {
          "name": "Get employee by ID - not found (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "999999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update employee",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "{{employeeId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Asha\",\n  \"lastName\": \"Menon\",\n  \"email\": \"asha.menon@example.com\",\n  \"phone\": \"+919876543210\",\n  \"department\": \"Engineering\",\n  \"designation\": \"Senior Software Engineer\",\n  \"salary\": 110000.0,\n  \"dateOfJoining\": \"2024-06-15\",\n  \"status\": \"ON_LEAVE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Delete employee",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "{{employeeId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('204 No Content', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Bulk employees",
      "item": [
        {
          "name": "Bulk create employees",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/bulk",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "employees",
                "bulk"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"firstName\": \"Meera\",\n    \"lastName\": \"Pillai\",\n    \"email\": \"meera.pillai@example.com\",\n    \"phone\": \"+919811111111\",\n    \"department\": \"Engineering\",\n    \"designation\": \"Software Engineer\",\n    \"salary\": 80000,\n    \"dateOfJoining\": \"2024-01-10\",\n    \"status\": \"ACTIVE\"\n  },\n  {\n    \"firstName\": \"Ravi\",\n    \"lastName\": \"Nair\",\n    \"email\": \"ravi.nair@example.com\",\n    \"department\": \"HR\",\n    \"designation\": \"HR Manager\",\n    \"salary\": 70000,\n    \"dateOfJoining\": \"2023-02-01\",\n    \"status\": \"ACTIVE\"\n  },\n  {\n    \"firstName\": \"Sanjay\",\n    \"lastName\": \"Kumar\",\n    \"email\": \"sanjay.kumar@example.com\",\n    \"department\": \"Finance\",\n    \"designation\": \"Accountant\",\n    \"salary\": 65000,\n    \"dateOfJoining\": \"2022-09-20\",\n    \"status\": \"INACTIVE\"\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "All-or-nothing, max 100 items. Stores created ids in {{bulkIds}}, {{bulkId1..3}}."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "const ids = pm.response.json().map(e => e.id);",
                  "pm.collectionVariables.set('bulkIds', ids.join(','));",
                  "pm.collectionVariables.set('bulkId1', ids[0]);",
                  "pm.collectionVariables.set('bulkId2', ids[1]);",
                  "pm.collectionVariables.set('bulkId3', ids[2]);"
                ]
              }
            }
          ]
        },
        {
          "name": "Bulk create - validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/employees/bulk",
